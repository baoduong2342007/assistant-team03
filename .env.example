# Environment Configuration Template for assistant-team03
# Copy this file to .env and adjust variables as needed.
# Note: Never commit your actual .env file or real secrets to git.

# Application Configuration
# Currently, the virtual assistant is rule-based and requires no external API keys.
APP_ENV=development
APP_LOG_LEVEL=INFO

